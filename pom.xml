<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <packaging>pom</packaging>
    <modules>
        <module>mybatis/mybatis-spring-boot-autoconfigure</module>
        <module>mybatis/mybatis-spring-boot-starter</module>
        <module>mybatis/mybatis-spring-boot-sample</module>
        <module>job/job-spring-boot-starter</module>
        <module>job/job-spring-boot-autoconfigure</module>
        <module>job/job-spring-boot-sample</module>
        <module>sentinel/sentinel-zuul-spring-boot-starter</module>
        <module>sentinel/sentinel-zuul-spring-boot-autoconfigure</module>
        <module>sentinel/sentinel-spring-boot-autoconfigure</module>
        <module>sentinel/sentinel-spring-boot-starter</module>
        <module>sentinel/sentinel-gateway-spring-boot-autoconfigure</module>
        <module>sentinel/sentinel-gateway-spring-boot-starter</module>
        <module>nacos/nacos-config-spring-boot-starter</module>
        <module>nacos/nacos-config-spring-boot-autoconfigure</module>
        <module>nacos/nacos-discovery-spring-boot-autoconfigure</module>
        <module>nacos/nacos-discovery-spring-boot-starter</module>
        <module>nacos/nacos-config-discovery-spring-boot-simple</module>
        <module>jpa/jpa-spring-boot-autoconfigure</module>
        <module>jpa/jpa-spring-boot-starter</module>
        <module>jpa/jpa-spring-boot-sample</module>
        <module>druid/druid-spring-boot-autoconfigure</module>
        <module>druid/druid-spring-boot-starter</module>
    </modules>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.3.11.RELEASE</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.yj2025</groupId>
    <artifactId>yj2025-spring-boot-starter</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <properties>
        <java.version>1.8</java.version>
        <spring-cloud.version>Hoxton.SR11</spring-cloud.version>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
    </properties>


    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <distributionManagement>
        <repository>
            <id>releases</id>
            <name>Nexus Release Repository</name>
            <url>http://nexus.yj2025.com/nexus/content/repositories/releases/</url>
        </repository>
        <snapshotRepository>
            <id>snapshots</id>
            <name>Nexus Snapshot Repository</name>
            <url>http://nexus.yj2025.com/nexus/content/repositories/snapshots/</url>
        </snapshotRepository>
    </distributionManagement>
    <repositories>
        <repository>
            <id>nexus</id>
            <url>http://nexus.yj2025.com/nexus/content/groups/public/</url>
        </repository>
    </repositories>


    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skipTests>true</skipTests>
                </configuration>
            </plugin>
        </plugins>
    </build>


</project>
