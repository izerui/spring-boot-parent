<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <packaging>pom</packaging>
    <modules>
        <module>audit-spring-boot</module>
        <module>customizer-spring-boot</module>
        <module>doc-spring-boot</module>
        <module>job-spring-boot</module>
        <module>jpa-spring-boot</module>
        <module>lock-spring-boot</module>
        <module>mvc-rest-spring-boot</module>
        <module>mybatis-spring-boot</module>
        <module>nacos-spring-boot</module>
        <module>rabbit-spring-boot</module>
        <module>redis-spring-boot</module>
        <module>sentinel-spring-boot</module>
        <module>websocket-spring-boot</module>
        <module>metrics-spring-boot</module>
        <module>sms-spring-boot</module>
        <module>amazonaws-spring-boot</module>
        <module>weixin-spring-boot</module>
        <module>sequence-number-spring-boot</module>
        <module>high-performance-spring-boot</module>
        <module>open-spring-boot</module>
        <module>mongo-transaction-spring-boot</module>
        <module>proxy-spring-boot</module>
        <module>basic-spring-boot</module>
        <module>data-jdbc-spring-boot</module>
        <module>public-commons</module>
    </modules>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.3.12.RELEASE</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.yj2025</groupId>
    <artifactId>yj2025-spring-boot-parent</artifactId>

    <version>1.5.3-SNAPSHOT</version>

    <properties>
        <java.version>11</java.version>
        <spring-cloud.version>Hoxton.SR12</spring-cloud.version>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <base-starter.version>1.5.3-SNAPSHOT</base-starter.version>
        <org.mapstruct.version>1.5.2.Final</org.mapstruct.version>
        <m2e.apt.activation>jdt_apt</m2e.apt.activation>
    </properties>


    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${org.mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${org.mapstruct.version}</version>
            </dependency>
<!--            <dependency>-->
<!--                <groupId>org.springframework.data</groupId>-->
<!--                <artifactId>spring-data-jdbc</artifactId>-->
<!--                <version>2.4.1</version>-->
<!--            </dependency>-->
<!--            <dependency>-->
<!--                <groupId>org.springframework.data</groupId>-->
<!--                <artifactId>spring-data-relational</artifactId>-->
<!--                <version>2.4.1</version>-->
<!--            </dependency>-->

            <!-- starter 基础依赖 -->
            <!-- job -->
            <dependency>
                <groupId>com.yj2025</groupId>
                <artifactId>job-spring-boot-starter</artifactId>
                <version>${base-starter.version}</version>
            </dependency>

            <!-- jpa -->
            <dependency>
                <groupId>com.yj2025</groupId>
                <artifactId>jpa-spring-boot-starter</artifactId>
                <version>${base-starter.version}</version>
            </dependency>

            <!-- mybatis -->
            <dependency>
                <groupId>com.yj2025</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${base-starter.version}</version>
            </dependency>

            <!-- nacos config -->
            <dependency>
                <groupId>com.yj2025</groupId>
                <artifactId>nacos-config-spring-boot-starter</artifactId>
                <version>${base-starter.version}</version>
            </dependency>

            <!-- nacos discovery -->
            <dependency>
                <groupId>com.yj2025</groupId>
                <artifactId>nacos-discovery-spring-boot-starter</artifactId>
                <version>${base-starter.version}</version>
            </dependency>

            <!-- sentinel gateway -->
            <dependency>
                <groupId>com.yj2025</groupId>
                <artifactId>sentinel-gateway-spring-boot-starter</artifactId>
                <version>${base-starter.version}</version>
            </dependency>

            <!-- sentinel micro service -->
            <dependency>
                <groupId>com.yj2025</groupId>
                <artifactId>sentinel-spring-boot-starter</artifactId>
                <version>${base-starter.version}</version>
            </dependency>

            <!-- sentinel zuul -->
            <dependency>
                <groupId>com.yj2025</groupId>
                <artifactId>sentinel-zuul-spring-boot-starter</artifactId>
                <version>${base-starter.version}</version>
            </dependency>

            <!-- rabbit -->
            <dependency>
                <groupId>com.yj2025</groupId>
                <artifactId>rabbit-spring-boot-starter</artifactId>
                <version>${base-starter.version}</version>
            </dependency>

            <!-- redis -->
            <dependency>
                <groupId>com.yj2025</groupId>
                <artifactId>redis-spring-boot-starter</artifactId>
                <version>${base-starter.version}</version>
            </dependency>

            <!-- websocket -->
            <dependency>
                <groupId>com.yj2025</groupId>
                <artifactId>websocket-producer-spring-boot-starter</artifactId>
                <version>${base-starter.version}</version>
            </dependency>

            <!-- websocket server -->
            <dependency>
                <groupId>com.yj2025</groupId>
                <artifactId>websocket-server-spring-boot-starter</artifactId>
                <version>${base-starter.version}</version>
            </dependency>

            <!-- audit -->
            <dependency>
                <groupId>com.yj2025</groupId>
                <artifactId>audit-spring-boot-starter</artifactId>
                <version>${base-starter.version}</version>
            </dependency>

            <!-- doc -->
            <dependency>
                <groupId>com.yj2025</groupId>
                <artifactId>doc-spring-boot-starter</artifactId>
                <version>${base-starter.version}</version>
            </dependency>

            <!-- mvc exception -->
            <dependency>
                <groupId>com.yj2025</groupId>
                <artifactId>mvc-rest-spring-boot-starter</artifactId>
                <version>${base-starter.version}</version>
            </dependency>

            <!-- mvc reactive exception -->
            <dependency>
                <groupId>com.yj2025</groupId>
                <artifactId>mvc-rest-reactive-spring-boot-starter</artifactId>
                <version>${base-starter.version}</version>
            </dependency>

            <!-- lock -->
            <dependency>
                <groupId>com.yj2025</groupId>
                <artifactId>lock-spring-boot-starter</artifactId>
                <version>${base-starter.version}</version>
            </dependency>

            <!-- override -->
            <dependency>
                <groupId>com.yj2025</groupId>
                <artifactId>customizer-spring-boot-starter</artifactId>
                <version>${base-starter.version}</version>
            </dependency>

            <!-- metrics -->
            <dependency>
                <groupId>com.yj2025</groupId>
                <artifactId>metrics-spring-boot-starter</artifactId>
                <version>${base-starter.version}</version>
            </dependency>

            <!-- sms -->
            <dependency>
                <groupId>com.yj2025</groupId>
                <artifactId>sms-spring-boot-starter</artifactId>
                <version>${base-starter.version}</version>
            </dependency>

            <!-- amazonaws-sdk -->
            <dependency>
                <groupId>com.yj2025</groupId>
                <artifactId>amazonaws-spring-boot-starter</artifactId>
                <version>${base-starter.version}</version>
            </dependency>
            <!-- work weixin-->
            <dependency>
                <groupId>com.yj2025</groupId>
                <artifactId>work-weixin-spring-boot-starter</artifactId>
                <version>${base-starter.version}</version>
            </dependency>
            <!-- sequence number -->
            <dependency>
                <groupId>com.yj2025</groupId>
                <artifactId>sequence-number-spring-boot-starter</artifactId>
                <version>${base-starter.version}</version>
            </dependency>
            <!-- oauth2 -->
            <dependency>
                <groupId>com.yj2025</groupId>
                <artifactId>oauth2-server-spring-boot-starter</artifactId>
                <version>${base-starter.version}</version>
            </dependency>
            <!-- gateway -->
            <dependency>
                <groupId>com.yj2025</groupId>
                <artifactId>gateway-spring-boot-starter</artifactId>
                <version>${base-starter.version}</version>
            </dependency>
            <!-- high-performance -->
            <dependency>
                <groupId>com.yj2025</groupId>
                <artifactId>high-performance-spring-boot-core</artifactId>
                <version>${base-starter.version}</version>
            </dependency>
            <!-- open-gateway -->
            <dependency>
                <groupId>com.yj2025</groupId>
                <artifactId>open-gateway-spring-boot-starter</artifactId>
                <version>${base-starter.version}</version>
            </dependency>
            <!-- open-oauth-server -->
            <dependency>
                <groupId>com.yj2025</groupId>
                <artifactId>open-oauth-server-spring-boot-starter</artifactId>
                <version>${base-starter.version}</version>
            </dependency>
            <!-- mongo -->
            <dependency>
                <groupId>com.yj2025</groupId>
                <artifactId>mongo-transaction-spring-boot-starter</artifactId>
                <version>${base-starter.version}</version>
            </dependency>
            <!-- basic -->
            <dependency>
                <groupId>com.yj2025</groupId>
                <artifactId>basic-spring-boot-starter</artifactId>
                <version>${base-starter.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>


    <repositories>
        <repository>
            <id>nexus</id>
            <url>http://192.168.1.235:8081/nexus/content/groups/public/</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>spring-snapshots</id>
            <url>https://repo.spring.io/snapshot</url>
        </pluginRepository>
        <pluginRepository>
            <id>spring-milestones</id>
            <url>https://repo.spring.io/milestone</url>
        </pluginRepository>
    </pluginRepositories>

    <distributionManagement>
        <repository>
            <id>releases</id>
            <name>Nexus Release Repository</name>
            <url>http://192.168.1.235:8081/nexus/content/repositories/releases/</url>
        </repository>
        <snapshotRepository>
            <id>snapshots</id>
            <name>Nexus Snapshot Repository</name>
            <url>http://192.168.1.235:8081/nexus/content/repositories/snapshots/</url>
        </snapshotRepository>
    </distributionManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>${maven-source-plugin.version}</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven-javadoc-plugin.version}</version>
                <configuration>
                    <show>private</show>
                    <nohelp>true</nohelp>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <skipTests>true</skipTests>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>${maven-resources-plugin.version}</version>
                <configuration>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>


</project>
